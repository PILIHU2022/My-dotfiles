[Unit]
Description=audiosnoop — 记录哪个软件在什么时候播放了声音
Documentation=file:%h/.config/audiosnoop/README.md
# 单独启停：systemctl --user start|stop|restart audiosnoop.service
# 整组启停：systemctl --user stop hyprland-autostart.target
PartOf=graphical-session.target hyprland-autostart.target
After=graphical-session.target
# PipeWire / pipewire-pulse 由 graphical-session 拉起；本服务自身带重连逻辑，
# 即使音频服务晚于它就绪也会自动接上，因此这里只做顺序上的松散约束。

[Service]
Type=exec
ExecStart=%h/.local/bin/audiosnoop run
# 守护进程必须持续在线才有意义：崩溃后拉起；正常退出（systemctl stop）不会重启。
Restart=on-failure
RestartSec=3
# 日志进 journald；PYTHONUNBUFFERED 让日志实时刷新，方便 journalctl -f 观察。
Environment=PYTHONUNBUFFERED=1
# 优先级让位于音频与前台应用，避免采样线程被抢占导致漏帧。
Nice=10
Slice=app-graphical.slice

[Install]
WantedBy=hyprland-autostart.target
