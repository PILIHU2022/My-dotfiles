#!/usr/bin/env python3
"""audiosnoop — 记录本机「哪个软件在什么时候播放了声音」。

为什么不能只看音频流：
  PulseAudio / PipeWire 的 sink-input 生命周期只能说明「谁建立了音频流」。但
  Firefox、Steam、Chromium 这类程序常年挂着若干条空闲流，「有流」不等于「在响」。
  因此本工具同时做两件事：

    1) 流跟踪：pactl subscribe 捕捉 sink-input 出现/消失/改名，再用 pactl 的 JSON
       输出补齐 PID、可执行文件、systemd unit、Flatpak ID、Hyprland 窗口标题；
    2) 音量探测：从默认输出设备的 monitor 源用 parec 实时采样，按 20ms 帧计算
       RMS→dBFS，用滞回阈值切出「真正出声」的片段，记录起止时间与峰值。

  最后把「出声时刻」与当时活跃的音频流相关联，回答「这段音效是谁放的」。可选
  --clips 把每次出声保存成 WAV（默认含 3 秒前摇），用来回听辨认陌生提示音。

数据落在 SQLite（默认 ~/.local/share/audiosnoop/audiosnoop.db），配合 systemd
user service 实现开机自启、崩溃自拉，重启后历史仍在。

子命令：
  run        前台运行守护进程（systemd unit 执行的就是它）
  watch      实时滚动显示新出现的音频流与出声事件
  log        查询历史（按时间/应用/关键词过滤，可导出 JSON、CSV）
  stats      按应用聚合统计次数与累计时长
  doctor     自检：音频服务、monitor、数据库、服务状态
  prune      清理过期数据
  selftest   播一声已知提示音，验证「能捕获 + 能归因」

示例：
  audiosnoop watch                     # 听到怪声时瞄一眼
  audiosnoop log --since 10m           # 最近十分钟谁响过
  audiosnoop log --app Firefox --json
  audiosnoop stats --since 7d
"""

from __future__ import annotations

import argparse
import array
import collections
import csv
import dataclasses
import datetime
import fcntl
import json
import logging
import math
import os
import re
import shutil
import signal
import sqlite3
import subprocess
import sys
import tempfile
import threading
import time
import unicodedata
import wave

APP = "audiosnoop"
__version__ = "1.0.0"

log = logging.getLogger(APP)

# --------------------------------------------------------------------------- #
# 默认配置（$XDG_CONFIG_HOME/audiosnoop/config.json，只写需要改的键即可）
# --------------------------------------------------------------------------- #
DEFAULTS = {
    "db_path": None,               # null → ~/.local/share/audiosnoop/audiosnoop.db
    "clips_dir": None,             # null → ~/.local/share/audiosnoop/clips
    "capture_clips": False,        # 是否保存出声片段的 WAV（涉隐私，默认关）
    "clip_preroll_sec": 3.0,       # 出声前保留的音频长度
    "clip_tail_sec": 0.8,          # 出声结束后继续录一点
    "clip_max_sec": 15.0,          # 单段片段最长秒数
    "sample_rate": 48000,
    "channels": 2,
    "frame_ms": 20,
    "start_db": -50.0,             # 起音阈值（monitor 静音是 -120 dBFS，-50 足够灵敏）
    "stop_db": -58.0,              # 收音阈值（滞回，低于起音 8 dB 防抖）
    "min_burst_sec": 0.04,         # 短于此的响动忽略（40ms，足以覆盖通知音）
    "merge_gap_sec": 0.45,         # 间隙小于此值的响动合并成一段
    "attribution_window_sec": 3.0, # 最近 N 秒新建的流视为高度可疑
    "audible_window_sec": 1.5,     # 新流出现后观察多久内是否有能量，用于判定「这条流真的出声了」
    "notify": False,               # 新流出现时弹桌面通知
    "notify_sound_too": False,     # 每次出声也弹通知（更吵）
    "retention_days": 30,          # <=0 表示永久保留
    "poll_interval_sec": 1.0,      # 兜底轮询间隔
    "sink": None,                  # null → 跟随系统默认输出
    "use_hyprctl": True,           # 用 hyprctl 补窗口标题
}

# --------------------------------------------------------------------------- #
# 数据库结构
# --------------------------------------------------------------------------- #
SCHEMA = """
CREATE TABLE IF NOT EXISTS meta (
    key   TEXT PRIMARY KEY,
    value TEXT
);

-- 一条 sink-input（音频流）的生命周期
CREATE TABLE IF NOT EXISTS streams (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    key         TEXT    NOT NULL,      -- pulse index + object.serial，防止 index 复用串号
    sink_input  INTEGER NOT NULL,
    ts_start    REAL    NOT NULL,      -- unix epoch（秒，浮点）
    ts_end      REAL,
    app         TEXT,                  -- application.name
    binary      TEXT,                  -- application.process.binary
    pid         INTEGER,
    exe         TEXT,                  -- /proc/<pid>/exe
    cmdline     TEXT,
    unit        TEXT,                  -- systemd unit/scope（来自 cgroup）
    flatpak     TEXT,                  -- Flatpak / Snap ID
    win_class   TEXT,
    win_title   TEXT,
    media_name  TEXT,                  -- 媒体名（网页标题/歌曲名/提示音名）
    sink        TEXT,
    sample_spec TEXT,
    node_name   TEXT,
    props       TEXT,                  -- 完整 pulse 属性 JSON
    clip        TEXT,                  -- 若本次出声归因到这条流，对应的片段
    audible     INTEGER,               -- 起流后 audible_window_sec 内是否检测到能量
    audible_peak_db REAL,
    audible_at  REAL
);
CREATE INDEX IF NOT EXISTS idx_streams_start ON streams(ts_start);
CREATE INDEX IF NOT EXISTS idx_streams_app   ON streams(app);

-- 一次「真正出声」的片段（monitor 源 dBFS 检测）
CREATE TABLE IF NOT EXISTS sounds (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    ts_start   REAL NOT NULL,
    ts_end     REAL,
    duration   REAL,
    peak_db    REAL,
    app        TEXT,                   -- 归因结果
    confidence TEXT,                   -- new / single / app-only / unknown
    stream_id  INTEGER,                -- 归因到的 streams.id
    candidates TEXT,                   -- 当时的候选流 JSON（留证据）
    clip       TEXT
);
CREATE INDEX IF NOT EXISTS idx_sounds_start ON sounds(ts_start);
CREATE INDEX IF NOT EXISTS idx_sounds_app   ON sounds(app);
"""

SCHEMA_VERSION = "1"

TIME_UNITS = {"s": 1.0, "m": 60.0, "h": 3600.0, "d": 86400.0, "w": 604800.0}


# --------------------------------------------------------------------------- #
# 小工具
# --------------------------------------------------------------------------- #
def now() -> float:
    return time.time()


def fmt_ts(ts: float | None, with_date: bool = True) -> str:
    if not ts:
        return "-"
    fmt = "%Y-%m-%d %H:%M:%S" if with_date else "%H:%M:%S"
    return time.strftime(fmt, time.localtime(ts))


def fmt_clock(ts: float | None) -> str:
    return "-" if not ts else time.strftime("%H:%M:%S", time.localtime(ts))


def fmt_dur(seconds: float | None) -> str:
    if seconds is None:
        return "-"
    seconds = max(0.0, seconds)
    if seconds < 1:
        return f"{seconds * 1000:.0f}ms"
    if seconds < 10:
        return f"{seconds:.2f}s"
    if seconds < 60:
        return f"{seconds:.1f}s"
    if seconds < 3600:
        return f"{int(seconds // 60)}m{int(seconds % 60):02d}s"
    if seconds < 86400:
        return f"{int(seconds // 3600)}h{int(seconds % 3600 // 60):02d}m"
    return f"{int(seconds // 86400)}d{int(seconds % 86400 // 3600):02d}h"


def char_width(ch: str) -> int:
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def disp_width(text: str) -> int:
    """终端显示宽度（中日韩全角字符占 2 列）。"""
    return sum(char_width(ch) for ch in text)


def pad(text: str, width: int) -> str:
    text = text or ""
    return text + " " * max(0, width - disp_width(text))


def trunc(text: str, width: int) -> str:
    text = (text or "").replace("\n", " ").replace("\r", " ")
    if disp_width(text) <= width:
        return text
    out, used = "", 0
    for ch in text:
        w = char_width(ch)
        if used + w > width - 1:
            break
        out += ch
        used += w
    return out + "…"


class Color:
    """仅在 stdout 是终端且未设置 NO_COLOR 时输出 ANSI 颜色。"""

    enabled = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None

    @classmethod
    def _wrap(cls, code: str, text: str) -> str:
        return f"\033[{code}m{text}\033[0m" if cls.enabled else text

    @classmethod
    def dim(cls, t: str) -> str:
        return cls._wrap("2", t)

    @classmethod
    def green(cls, t: str) -> str:
        return cls._wrap("32", t)

    @classmethod
    def red(cls, t: str) -> str:
        return cls._wrap("31", t)

    @classmethod
    def cyan(cls, t: str) -> str:
        return cls._wrap("36", t)

    @classmethod
    def yellow(cls, t: str) -> str:
        return cls._wrap("33", t)

    @classmethod
    def magenta(cls, t: str) -> str:
        return cls._wrap("35", t)

    @classmethod
    def bold(cls, t: str) -> str:
        return cls._wrap("1", t)


def which_any(*names: str) -> str | None:
    for name in names:
        found = shutil.which(name)
        if found:
            return found
        for prefix in ("/usr/bin", "/usr/local/bin", "/bin"):
            candidate = os.path.join(prefix, name)
            if os.access(candidate, os.X_OK):
                return candidate
    return None


def run_cmd(cmd: list[str], timeout: float = 5.0) -> tuple[int, str, str]:
    """执行命令，返回 (returncode, stdout, stderr)；无法启动时返回 (-1, '', 原因)。"""
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)
        return proc.returncode, proc.stdout, proc.stderr
    except (OSError, subprocess.SubprocessError) as exc:
        return -1, "", str(exc)


# --------------------------------------------------------------------------- #
# 配置与路径
# --------------------------------------------------------------------------- #
def config_path(explicit: str | None = None) -> str:
    if explicit:
        return os.path.abspath(os.path.expanduser(explicit))
    env = os.environ.get("AUDIOSNOOP_CONFIG")
    if env:
        return os.path.abspath(os.path.expanduser(env))
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, APP, "config.json")


def load_config(explicit: str | None = None) -> dict:
    cfg = dict(DEFAULTS)
    path = config_path(explicit)
    if os.path.exists(path):
        try:
            with open(path, "r", encoding="utf-8") as handle:
                user = json.load(handle)
            if not isinstance(user, dict):
                raise TypeError("顶层必须是 JSON 对象")
            user = {k: v for k, v in user.items() if not k.startswith("_")}
            unknown = sorted(k for k in user if k not in DEFAULTS)
            if unknown:
                log.warning("忽略未知配置项：%s", ", ".join(unknown))
            cfg.update({k: v for k, v in user.items() if k in DEFAULTS})
        except (OSError, ValueError) as exc:
            log.error("配置文件 %s 读取失败：%s（改用默认值）", path, exc)
    cfg["_path"] = path
    return cfg


def data_home() -> str:
    env = os.environ.get("AUDIOSNOOP_DATA_DIR")
    if env:
        return os.path.abspath(os.path.expanduser(env))
    base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return os.path.join(base, APP)


def resolve_db(cfg: dict, override: str | None = None) -> str:
    if override:
        return os.path.abspath(os.path.expanduser(override))
    if cfg.get("db_path"):
        return os.path.abspath(os.path.expanduser(cfg["db_path"]))
    return os.path.join(data_home(), "audiosnoop.db")


def resolve_clips(cfg: dict, override: str | None = None) -> str:
    if override:
        return os.path.abspath(os.path.expanduser(override))
    if cfg.get("clips_dir"):
        return os.path.abspath(os.path.expanduser(cfg["clips_dir"]))
    return os.path.join(data_home(), "clips")


# --------------------------------------------------------------------------- #
# SQLite 存储层（多线程写入，用一把可重入锁串行化）
# --------------------------------------------------------------------------- #
STREAM_COLUMNS = (
    "key", "sink_input", "ts_start", "ts_end", "app", "binary", "pid", "exe",
    "cmdline", "unit", "flatpak", "win_class", "win_title", "media_name",
    "sink", "sample_spec", "node_name", "props", "clip",
)


class Store:
    def __init__(self, path: str):
        self.path = path
        directory = os.path.dirname(path)
        if directory:
            os.makedirs(directory, mode=0o700, exist_ok=True)
        self._lock = threading.RLock()
        self._conn = sqlite3.connect(path, timeout=15.0, check_same_thread=False)
        self._conn.row_factory = sqlite3.Row
        # 记录的是应用使用行为，收紧到仅本人可读（含 WAL/SHM 附属文件）
        for suffix in ("", "-wal", "-shm"):
            try:
                os.chmod(path + suffix, 0o600)
            except OSError:
                pass
        with self._lock:
            self._conn.executescript(SCHEMA)
            self._migrate()
            self._conn.execute(
                "INSERT OR REPLACE INTO meta(key, value) VALUES ('schema_version', ?)",
                (SCHEMA_VERSION,),
            )
            self._conn.commit()

    def _migrate(self) -> None:
        """旧库补列，避免升级脚本后必须删库。"""
        existing = {row["name"] for row in self._conn.execute("PRAGMA table_info(streams)")}
        for column, decl in (
            ("audible", "INTEGER"), ("audible_peak_db", "REAL"), ("audible_at", "REAL"),
        ):
            if column not in existing:
                self._conn.execute(f"ALTER TABLE streams ADD COLUMN {column} {decl}")

    def add_stream(self, record: dict) -> int:
        cols = [c for c in STREAM_COLUMNS if c in record]
        sql = f"INSERT INTO streams({','.join(cols)}) VALUES({','.join('?' for _ in cols)})"
        with self._lock, self._conn:
            cur = self._conn.execute(sql, [record[c] for c in cols])
            return int(cur.lastrowid)

    def end_stream(self, row_id: int, ts_end: float) -> None:
        with self._lock, self._conn:
            self._conn.execute(
                "UPDATE streams SET ts_end = ? WHERE id = ? AND ts_end IS NULL", (ts_end, row_id)
            )

    def update_stream_media(self, row_id: int, media_name: str) -> None:
        with self._lock, self._conn:
            self._conn.execute("UPDATE streams SET media_name = ? WHERE id = ?", (media_name, row_id))

    def mark_stream_audible(self, row_id: int, peak_db: float, stamp: float) -> None:
        with self._lock, self._conn:
            self._conn.execute(
                "UPDATE streams SET audible = 1, audible_peak_db = ?, audible_at = ? WHERE id = ?",
                (round(peak_db, 1), stamp, row_id),
            )

    def update_stream_clip(self, row_id: int, clip: str) -> None:
        with self._lock, self._conn:
            self._conn.execute("UPDATE streams SET clip = ? WHERE id = ?", (clip, row_id))

    def add_sound(self, record: dict) -> int:
        cols = list(record)
        sql = f"INSERT INTO sounds({','.join(cols)}) VALUES({','.join('?' for _ in cols)})"
        with self._lock, self._conn:
            cur = self._conn.execute(sql, [record[c] for c in cols])
            return int(cur.lastrowid)

    def touch_sound(self, row_id: int, ts_end: float, peak_db: float) -> None:
        with self._lock, self._conn:
            self._conn.execute(
                "UPDATE sounds SET ts_end = ?, duration = ts_end - ts_start, peak_db = ? WHERE id = ?",
                (ts_end, peak_db, row_id),
            )

    def finish_sound(
        self,
        row_id: int,
        ts_end: float,
        peak_db: float,
        clip: str | None = None,
        app: str | None = None,
        confidence: str | None = None,
        stream_id: int | None = None,
    ) -> None:
        sets = ["ts_end = ?", "duration = ? - ts_start", "peak_db = ?"]
        params: list = [ts_end, ts_end, peak_db]
        for column, value in (
            ("clip", clip), ("app", app), ("confidence", confidence), ("stream_id", stream_id),
        ):
            if value:
                sets.append(f"{column} = ?")
                params.append(value)
        params.append(row_id)
        with self._lock, self._conn:
            self._conn.execute(f"UPDATE sounds SET {', '.join(sets)} WHERE id = ?", params)

    def prune(self, retention_days: float) -> tuple[int, int, int]:
        """删除超过保留期的记录及其片段，返回 (流条数, 声音条数, 片段文件数)。"""
        if not retention_days or retention_days <= 0:
            return 0, 0, 0
        cutoff = now() - retention_days * 86400.0
        clips: list[str] = []
        with self._lock, self._conn:
            for row in self._conn.execute(
                "SELECT clip FROM streams WHERE ts_start < ? AND clip IS NOT NULL", (cutoff,)
            ):
                clips.append(row["clip"])
            for row in self._conn.execute(
                "SELECT clip FROM sounds WHERE ts_start < ? AND clip IS NOT NULL", (cutoff,)
            ):
                clips.append(row["clip"])
            n_streams = self._conn.execute(
                "DELETE FROM streams WHERE ts_start < ? AND (ts_end IS NULL OR ts_end < ?)",
                (cutoff, cutoff),
            ).rowcount
            n_sounds = self._conn.execute("DELETE FROM sounds WHERE ts_start < ?", (cutoff,)).rowcount
        removed = 0
        for path in clips:
            try:
                os.unlink(path)
                removed += 1
            except OSError:
                pass
        return n_streams, n_sounds, removed

    def clear(self) -> tuple[int, int]:
        with self._lock, self._conn:
            streams = self._conn.execute("DELETE FROM streams").rowcount
            sounds = self._conn.execute("DELETE FROM sounds").rowcount
        return streams, sounds

    def vacuum(self) -> None:
        with self._lock:
            self._conn.execute("VACUUM")

    def close(self) -> None:
        with self._lock:
            try:
                self._conn.commit()
            finally:
                self._conn.close()


# --------------------------------------------------------------------------- #
# PulseAudio / PipeWire 交互
# --------------------------------------------------------------------------- #
@dataclasses.dataclass
class SinkInput:
    """一条 sink-input 的快照。"""

    index: int
    sink: str | None = None
    sample_spec: str | None = None
    corked: bool = False
    client_id: str | None = None
    props: dict = dataclasses.field(default_factory=dict)

    @property
    def key(self) -> str:
        serial = self.props.get("object.serial") or self.props.get("node.id") or ""
        return f"{self.index}:{serial}"

    @property
    def app(self) -> str:
        return (
            self.props.get("application.name")
            or self.props.get("application.id")
            or self.props.get("node.name")
            or self.props.get("node.description")
            or "(未知)"
        )

    @property
    def media_name(self) -> str | None:
        return self.props.get("media.name") or self.props.get("node.description")

    @property
    def binary(self) -> str | None:
        return self.props.get("application.process.binary")

    @property
    def node_name(self) -> str | None:
        return self.props.get("node.name")

    @property
    def pid(self) -> int | None:
        raw = self.props.get("application.process.id")
        try:
            return int(str(raw)) if raw not in (None, "") else None
        except (TypeError, ValueError):
            return None


def pactl_bin() -> str | None:
    return which_any("pactl")


def pactl_info() -> dict:
    binary = pactl_bin()
    if not binary:
        return {}
    code, out, _ = run_cmd([binary, "info"], timeout=5)
    if code != 0:
        return {}
    info = {}
    for line in out.splitlines():
        if ":" in line:
            key, _, value = line.partition(":")
            info[key.strip()] = value.strip()
    return info


def default_sink() -> str | None:
    binary = pactl_bin()
    if not binary:
        return None
    code, out, _ = run_cmd([binary, "get-default-sink"], timeout=5)
    if code == 0 and out.strip():
        return out.strip()
    return pactl_info().get("Default Sink")


def list_monitor_names() -> list[str]:
    binary = pactl_bin()
    if not binary:
        return []
    code, out, _ = run_cmd([binary, "list", "short", "sources"], timeout=5)
    if code != 0:
        return []
    return [line.split("\t")[1] for line in out.splitlines() if "\t" in line]


def monitor_device(sink: str | None) -> str | None:
    """把 sink 名转换成对应的 monitor 源名。"""
    target = sink or default_sink()
    if not target:
        return None
    names = list_monitor_names()
    candidate = f"{target}.monitor"
    if candidate in names:
        return candidate
    for name in names:
        if name.endswith(".monitor") and target.split(".")[0] in name:
            return name
    return candidate


def _json_list(kind: str) -> list | None:
    binary = pactl_bin()
    if not binary:
        return None
    code, out, _ = run_cmd([binary, "-f", "json", "list", kind], timeout=8)
    if code != 0 or not out.strip():
        return None
    try:
        data = json.loads(out)
    except ValueError:
        return None
    if isinstance(data, dict):
        data = [data]
    return data if isinstance(data, list) else None


def _text_blocks(text: str, header: str) -> list[list[str]]:
    blocks: list[list[str]] = []
    current: list[str] | None = None
    for line in text.splitlines():
        if line.startswith(header):
            current = []
            blocks.append(current)
        elif current is not None:
            current.append(line)
    return blocks


def _parse_text_sink_inputs(text: str) -> list[SinkInput]:
    """pactl < 16 无 JSON 输出时的兜底解析。"""
    result: list[SinkInput] = []
    for block in _text_blocks(text, "Sink Input #"):
        match = re.search(r"#(\d+)", block[0] if block else "")
        if not match:
            continue
        entry = SinkInput(index=int(match.group(1)))
        in_props = False
        for line in block[1:]:
            stripped = line.strip()
            if not stripped:
                continue
            if line.startswith("\t\t") and in_props:
                key, sep, value = stripped.partition(" = ")
                if not sep:
                    continue
                value = value.strip()
                if len(value) >= 2 and value[0] == value[-1] == '"':
                    value = value[1:-1].replace('\\"', '"').replace("\\\\", "\\")
                entry.props[key] = value
                continue
            key, sep, value = stripped.partition(": ")
            if not sep:
                continue
            in_props = key == "Properties"
            if key == "Sink":
                entry.sink = value
            elif key == "Client" and value.isdigit():
                entry.client_id = value
            elif key == "Sample Specification":
                entry.sample_spec = value
            elif key == "Corked":
                entry.corked = value.strip().lower() == "yes"
        result.append(entry)
    return result


def list_sink_inputs() -> list[SinkInput]:
    data = _json_list("sink-inputs")
    if data is not None:
        entries = []
        for item in data:
            entries.append(
                SinkInput(
                    index=int(item.get("index", -1)),
                    sink=str(item["sink"]) if item.get("sink") is not None else None,
                    sample_spec=item.get("sample_specification"),
                    corked=bool(item.get("corked")),
                    client_id=str(item["client"]) if item.get("client") is not None else None,
                    props=item.get("properties") or {},
                )
            )
        return entries
    binary = pactl_bin()
    if not binary:
        return []
    code, out, _ = run_cmd([binary, "list", "sink-inputs"], timeout=8)
    if code != 0:
        return []
    return _parse_text_sink_inputs(out)


def client_pids() -> dict[str, int]:
    """client index → PID（部分流自身不带 application.process.id）。"""
    mapping: dict[str, int] = {}
    for item in _json_list("clients") or []:
        raw = (item.get("properties") or {}).get("application.process.id")
        try:
            if raw is not None:
                mapping[str(item.get("index"))] = int(raw)
        except (TypeError, ValueError):
            continue
    return mapping


# --------------------------------------------------------------------------- #
# 进程 / 窗口信息补全
# --------------------------------------------------------------------------- #
def _read_bytes(path: str, limit: int = 8192) -> bytes:
    try:
        with open(path, "rb") as handle:
            return handle.read(limit)
    except OSError:
        return b""


def proc_metadata(pid: int | None) -> dict:
    """从 /proc 补齐可执行文件、命令行、systemd unit、Flatpak/Snap ID。"""
    meta = {"exe": None, "cmdline": None, "unit": None, "flatpak": None}
    if not pid or pid <= 0:
        return meta
    try:
        meta["exe"] = os.readlink(f"/proc/{pid}/exe")
    except OSError:
        pass
    raw = _read_bytes(f"/proc/{pid}/cmdline")
    if raw:
        parts = [p for p in raw.split(b"\0") if p]
        meta["cmdline"] = " ".join(p.decode("utf-8", "replace") for p in parts)[:2000]
    cgroup = _read_bytes(f"/proc/{pid}/cgroup").decode("utf-8", "replace")
    for line in cgroup.splitlines():
        path = line.split("::", 1)[-1].strip()
        matches = re.findall(r"([^/]+\.(?:service|scope))", path)
        if matches:
            meta["unit"] = matches[-1]
            break
    for item in _read_bytes(f"/proc/{pid}/environ", limit=65536).split(b"\0"):
        if item.startswith(b"FLATPAK_ID="):
            meta["flatpak"] = item.split(b"=", 1)[1].decode("utf-8", "replace")
        elif item.startswith(b"SNAP_NAME=") and not meta["flatpak"]:
            meta["flatpak"] = "snap:" + item.split(b"=", 1)[1].decode("utf-8", "replace")
    return meta


class WindowMapper:
    """用 hyprctl 把 PID 映射成 Hyprland 窗口的 class / title（带缓存）。"""

    def __init__(self, enabled: bool = True, ttl: float = 2.0):
        self.enabled = enabled and which_any("hyprctl") is not None
        self.ttl = ttl
        self._cache: dict[int, tuple[str | None, str | None]] = {}
        self._loaded_at = 0.0
        self._lock = threading.Lock()

    def _refresh(self) -> None:
        binary = which_any("hyprctl")
        if not binary:
            self.enabled = False
            return
        code, out, _ = run_cmd([binary, "-j", "clients"], timeout=5)
        if code != 0:
            return
        try:
            clients = json.loads(out)
        except ValueError:
            return
        mapping: dict[int, tuple[str | None, str | None]] = {}
        for client in clients if isinstance(clients, list) else []:
            pid = client.get("pid")
            if isinstance(pid, int):
                mapping[pid] = (client.get("class"), client.get("title"))
        self._cache = mapping
        self._loaded_at = time.monotonic()

    def lookup(self, pid: int | None) -> tuple[str | None, str | None]:
        if not self.enabled or not pid:
            return None, None
        with self._lock:
            if time.monotonic() - self._loaded_at > self.ttl:
                self._refresh()
            return self._cache.get(pid, (None, None))


def send_notification(title: str, body: str, icon: str = "audio-volume-high") -> None:
    binary = which_any("notify-send")
    if not binary:
        return
    try:
        subprocess.Popen(
            [binary, "-a", APP, "-i", icon, "-t", "4000", title, body],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError:
        pass


# --------------------------------------------------------------------------- #
# 流跟踪线程：pactl subscribe 事件 + 兜底轮询
# --------------------------------------------------------------------------- #
class StreamTracker(threading.Thread):
    def __init__(self, service: Service):
        super().__init__(name="stream-tracker", daemon=True)
        self.service = service
        self.stop_event = threading.Event()
        self.wake = threading.Event()
        self._proc: subprocess.Popen | None = None

    def _watch_events(self) -> None:
        binary = pactl_bin()
        if not binary:
            return
        cmd = [binary, "subscribe"]
        stdbuf = which_any("stdbuf")
        if stdbuf:  # 强制行缓冲，否则管道里的 subscribe 输出会被攒住
            cmd = [stdbuf, "-oL", "-eL"] + cmd
        while not self.stop_event.is_set():
            try:
                self._proc = subprocess.Popen(
                    cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                    text=True, bufsize=1,
                )
            except OSError as exc:
                log.error("无法启动 pactl subscribe：%s", exc)
                return
            assert self._proc.stdout is not None
            for line in iter(self._proc.stdout.readline, ""):
                if self.stop_event.is_set():
                    break
                if "sink-input" in line or "on server" in line:
                    self.wake.set()
            self._proc.wait()
            self._proc = None
            if self.stop_event.is_set():
                return
            log.warning("pactl subscribe 已退出，2 秒后重连")
            self.stop_event.wait(2.0)

    def stop(self) -> None:
        self.stop_event.set()
        self.wake.set()
        proc = self._proc
        if proc and proc.poll() is None:
            try:
                proc.terminate()
            except OSError:
                pass

    def run(self) -> None:
        threading.Thread(target=self._watch_events, name="pactl-events", daemon=True).start()
        log.info("流跟踪已启动（pactl subscribe）")
        interval = float(self.service.cfg["poll_interval_sec"])
        while not self.stop_event.is_set():
            triggered = self.wake.wait(timeout=interval)
            self.wake.clear()
            if self.stop_event.is_set():
                return
            if triggered:
                time.sleep(0.03)  # 等音频服务把属性写全
            try:
                self.service.refresh_streams()
            except Exception:  # 守护进程不能因单次刷新失败退出
                log.exception("刷新音频流状态失败")


# --------------------------------------------------------------------------- #
# 音量监视器：parec 采集 monitor 源 → dBFS → 出声片段
# --------------------------------------------------------------------------- #
@dataclasses.dataclass
class Burst:
    """正在进行的出声片段。"""

    ts_start: float
    peak_db: float = -120.0
    silence: float = 0.0
    frames: list = dataclasses.field(default_factory=list)
    frames_bytes: int = 0
    preroll: list = dataclasses.field(default_factory=list)
    row_id: int | None = None
    last_write: float = 0.0
    app: str | None = None
    confidence: str | None = None
    stream_id: int | None = None


@dataclasses.dataclass
class PendingAudible:
    """等待判定「这条流是否真的发出了声音」的观察窗口。"""

    row_id: int
    app: str
    start: float
    until: float
    peak: float = -120.0


class AudioMonitor(threading.Thread):
    def __init__(self, service: Service):
        super().__init__(name="audio-monitor", daemon=True)
        self.service = service
        self.cfg = service.cfg
        self.store = service.store
        self.stop_event = threading.Event()
        self.restart_event = threading.Event()
        self.device: str | None = None
        self.error: str | None = None
        self._proc: subprocess.Popen | None = None
        self._errfile = None

        cfg = self.cfg
        frame_samples = int(cfg["sample_rate"] * cfg["frame_ms"] / 1000)
        self.frame_bytes = frame_samples * int(cfg["channels"]) * 2
        self.frame_sec = cfg["frame_ms"] / 1000.0
        self.bytes_per_sec = int(cfg["sample_rate"]) * int(cfg["channels"]) * 2
        self.ring = collections.deque()
        self.ring_bytes = 0
        self.ring_max = int(cfg["clip_preroll_sec"] * self.bytes_per_sec)
        # 不保存片段时就不必攒 PCM（省内存）
        self.max_burst_bytes = (
            int(cfg["clip_max_sec"] * self.bytes_per_sec) if cfg["capture_clips"] else 0
        )
        self.burst: Burst | None = None
        self.pending: list[PendingAudible] = []
        self.pending_lock = threading.Lock()
        self.clips_dir: str | None = None
        if cfg["capture_clips"]:
            try:
                self.clips_dir = resolve_clips(cfg)
                os.makedirs(self.clips_dir, mode=0o700, exist_ok=True)
            except OSError as exc:
                log.error("片段目录不可用（%s），本次不保存 WAV", exc)
                self.clips_dir = None

    # -- 生命周期 -------------------------------------------------------- #
    def stop(self) -> None:
        self.stop_event.set()
        self._kill_proc()

    def request_restart(self) -> None:
        self.restart_event.set()

    def watch_stream(self, row_id: int, app: str, start: float) -> None:
        """流刚出现时登记观察窗口，后续由音频帧回调判定它是否真的出声。"""
        window = float(self.cfg["audible_window_sec"])
        cutoff = start - 120.0
        with self.pending_lock:
            self.pending = [p for p in self.pending if p.until >= cutoff]
            self.pending.append(
                PendingAudible(row_id=row_id, app=app, start=start, until=start + window)
            )

    def _kill_proc(self) -> None:
        proc = self._proc
        if proc and proc.poll() is None:
            try:
                proc.terminate()
                proc.wait(timeout=2)
            except (OSError, subprocess.SubprocessError):
                try:
                    proc.kill()
                except OSError:
                    pass

    def _read_stderr(self) -> str:
        if not self._errfile:
            return ""
        try:
            self._errfile.seek(0)
            return (self._errfile.read() or b"").decode("utf-8", "replace").strip()[-400:]
        except (OSError, ValueError):
            return ""

    # -- 主循环 ---------------------------------------------------------- #
    def run(self) -> None:
        parec = which_any("parec", "pacat")
        if not parec:
            log.error("找不到 parec/pacat：只能记录音频流，无法检测是否真的出声")
            self.error = "缺少 parec"
            return
        rate = str(int(self.cfg["sample_rate"]))
        channels = str(int(self.cfg["channels"]))
        backoff = 1.0
        while not self.stop_event.is_set():
            device = self.device or monitor_device(self.cfg["sink"])
            if not device:
                log.error("找不到可监听的 monitor 设备（音频服务未就绪？）")
                self.error = "找不到 monitor 设备"
                self.stop_event.wait(5.0)
                continue
            self.device = device
            cmd = [
                parec, "--raw", "--format=s16le", f"--rate={rate}",
                f"--channels={channels}", f"--device={device}",
                "--latency-msec=25", "--client-name=audiosnoop",
            ]
            self._close_errfile()
            self._errfile = tempfile.TemporaryFile()  # noqa: SIM115 - 需要跨线程持有
            log.info("开始监听 %s（起音阈值 %.0f dBFS）", device, self.cfg["start_db"])
            try:
                self._proc = subprocess.Popen(
                    cmd, stdout=subprocess.PIPE, stderr=self._errfile, bufsize=0
                )
            except OSError as exc:
                log.error("启动 parec 失败：%s", exc)
                self.error = str(exc)
                self.stop_event.wait(5.0)
                continue
            self.error = None
            assert self._proc.stdout is not None
            restart = self._consume(self._proc.stdout)
            self._kill_proc()
            self._proc = None
            self._finish_burst()
            if self.stop_event.is_set():
                break
            if restart:
                backoff = 1.0
                continue
            message = self._read_stderr()
            log.warning("parec 已断开（%s），%.0f 秒后重连", message or "无输出", backoff)
            self.error = message or "parec 断开"
            self.stop_event.wait(backoff)
            backoff = min(backoff * 2, 15.0)
        self._finish_burst()
        self._close_errfile()

    def _close_errfile(self) -> None:
        if self._errfile:
            try:
                self._errfile.close()
            except OSError:
                pass
            self._errfile = None

    def _read_exact(self, stream, size: int) -> bytes:
        chunks = []
        remaining = size
        while remaining > 0 and not self.stop_event.is_set():
            piece = stream.read(remaining)
            if not piece:
                return b"".join(chunks)
            chunks.append(piece)
            remaining -= len(piece)
        return b"".join(chunks)

    def _consume(self, stream) -> bool:
        """读取 PCM；返回 True 表示因默认设备切换而主动重连。"""
        while not self.stop_event.is_set():
            if self.restart_event.is_set():
                self.restart_event.clear()
                self._finish_burst()
                log.info("默认输出设备发生变化，重新连接 monitor")
                return True
            chunk = self._read_exact(stream, self.frame_bytes)
            if len(chunk) < self.frame_bytes:
                return False
            self._handle_frame(chunk)
        return False

    # -- 电平与状态机 ---------------------------------------------------- #
    def _handle_frame(self, chunk: bytes) -> None:
        level = self._level_db(chunk)
        stamp = now()
        self._update_pending(stamp, level)
        self._push_ring(chunk)
        burst = self.burst
        start_db = float(self.cfg["start_db"])
        stop_db = float(self.cfg["stop_db"])
        if burst is None:
            if level >= start_db:
                log.debug("检测到起音 %.1f dBFS", level)
                self.burst = Burst(
                    ts_start=stamp, peak_db=level, preroll=list(self.ring),
                    frames=[chunk], frames_bytes=len(chunk), last_write=stamp,
                )
            return
        if level >= stop_db:
            burst.silence = 0.0
            burst.peak_db = max(burst.peak_db, level)
            self._append_frame(chunk)
            self._maybe_commit(stamp)
            self._maybe_checkpoint(stamp)
            return
        burst.silence += self.frame_sec
        # 尾巴：收尾前再留一点静音，避免片段切得太干净听不出语境
        if burst.silence <= float(self.cfg["clip_tail_sec"]):
            self._append_frame(chunk)
        if burst.silence >= float(self.cfg["merge_gap_sec"]):
            self._finish_burst(stamp - burst.silence)

    def _update_pending(self, stamp: float, level: float) -> None:
        """统计观察窗口内的峰值，窗口到期后写入 streams.audible。

        这条判定独立于「出声片段」：即使正在放音乐把提示音盖住，只要新建的流
        在它自己的窗口内有能量，就说明它大概率是刚才那个响动的来源。
        """
        if not self.pending:
            return
        finished: list[PendingAudible] = []
        with self.pending_lock:
            for item in self.pending:
                if item.start <= stamp <= item.until:
                    item.peak = max(item.peak, level)
                elif stamp > item.until:
                    finished.append(item)
            for item in finished:
                self.pending.remove(item)
        threshold = float(self.cfg["start_db"])
        for item in finished:
            if item.peak < threshold:
                continue
            self.store.mark_stream_audible(item.row_id, item.peak, item.until)
            if self.cfg["notify"] and self.cfg["notify_sound_too"]:
                send_notification(
                    f"♪ {item.app}", f"确实发出了声音（峰值 {item.peak:.0f} dBFS）"
                )

    def _push_ring(self, chunk: bytes) -> None:
        if self.ring_max <= 0:
            return
        self.ring.append(chunk)
        self.ring_bytes += len(chunk)
        while self.ring_bytes > self.ring_max and self.ring:
            self.ring_bytes -= len(self.ring.popleft())

    def _append_frame(self, chunk: bytes) -> None:
        burst = self.burst
        if burst is None or burst.frames_bytes >= self.max_burst_bytes:
            return
        burst.frames.append(chunk)
        burst.frames_bytes += len(chunk)

    def _level_db(self, chunk: bytes) -> float:
        samples = array.array("h")
        samples.frombytes(chunk)
        if sys.byteorder == "big":
            samples.byteswap()
        if not samples:
            return -120.0
        total = 0
        for value in samples:
            total += value * value
        rms = math.sqrt(total / len(samples)) / 32768.0
        return 20.0 * math.log10(rms) if rms > 1e-7 else -120.0

    def _maybe_commit(self, stamp: float) -> None:
        """响动持续超过 min_burst_sec 后立刻落库，长音效也能实时看到。"""
        burst = self.burst
        if burst is None or burst.row_id is not None:
            return
        if stamp - burst.ts_start < float(self.cfg["min_burst_sec"]):
            return
        candidates, best, confidence = self.service.attribute(stamp)
        burst.app = best.app if best else None
        burst.confidence = confidence
        burst.stream_id = best.row_id if best else None
        burst.row_id = self.store.add_sound(
            {
                "ts_start": burst.ts_start,
                "ts_end": stamp,
                "duration": stamp - burst.ts_start,
                "peak_db": round(burst.peak_db, 1),
                "app": best.app if best else None,
                "confidence": confidence,
                "stream_id": best.row_id if best else None,
                "candidates": json.dumps(candidates, ensure_ascii=False),
                "clip": None,
            }
        )

    def _maybe_checkpoint(self, stamp: float) -> None:
        burst = self.burst
        if burst is None or burst.row_id is None:
            return
        if stamp - burst.last_write >= 2.0:
            burst.last_write = stamp
            self.store.touch_sound(burst.row_id, stamp, burst.peak_db)

    def _finish_burst(self, ts_end: float | None = None) -> None:
        burst = self.burst
        if burst is None:
            return
        self.burst = None
        stamp = ts_end or now()
        duration = max(0.0, stamp - burst.ts_start)
        if duration < float(self.cfg["min_burst_sec"]):
            log.debug(
                "忽略过短响动 %.3fs（min_burst_sec=%.3f，峰值 %.1f dBFS）",
                duration, self.cfg["min_burst_sec"], burst.peak_db,
            )
            return
        candidates, best, confidence = self.service.attribute(burst.ts_start)
        if burst.app:
            # 片段开始时已经定过归因（更接近「谁先响的」），不要被后来的流覆盖
            app, confidence, stream_id = burst.app, burst.confidence, burst.stream_id
        else:
            app = best.app if best else None
            stream_id = best.row_id if best else None
        clip = self._write_clip(burst, app) if self.clips_dir else None
        if burst.row_id is None:
            burst.row_id = self.store.add_sound(
                {
                    "ts_start": burst.ts_start,
                    "ts_end": stamp,
                    "duration": duration,
                    "peak_db": round(burst.peak_db, 1),
                    "app": app,
                    "confidence": confidence,
                    "stream_id": stream_id,
                    "candidates": json.dumps(candidates, ensure_ascii=False),
                    "clip": clip,
                }
            )
        else:
            self.store.finish_sound(
                burst.row_id, stamp, burst.peak_db, clip, app, confidence, stream_id
            )
        log.debug(
            "出声片段 %.2fs / 峰值 %.1f dBFS → %s（%s）",
            duration, burst.peak_db, app or "未知", confidence,
        )
        if clip and stream_id:
            self.store.update_stream_clip(stream_id, clip)
        if self.cfg["notify"] and self.cfg["notify_sound_too"]:
            send_notification(
                f"♪ 声音 {fmt_dur(duration)}",
                f"{app or '未知应用'} · 峰值 {burst.peak_db:.0f} dBFS",
            )

    def _write_clip(self, burst: Burst, app: str | None) -> str | None:
        if not self.clips_dir:
            return None
        frames = list(burst.preroll) + list(burst.frames)
        if not frames:
            return None
        safe = re.sub(r"[^A-Za-z0-9._-]+", "_", app or "unknown")[:40].strip("_") or "unknown"
        name = time.strftime("%Y%m%d-%H%M%S", time.localtime(burst.ts_start))
        path = os.path.join(self.clips_dir, f"{name}-{safe}.wav")
        try:
            with wave.open(path, "wb") as handle:
                handle.setnchannels(int(self.cfg["channels"]))
                handle.setsampwidth(2)
                handle.setframerate(int(self.cfg["sample_rate"]))
                handle.writeframes(b"".join(frames))
        except (OSError, wave.Error) as exc:
            log.warning("写入片段失败：%s", exc)
            return None
        return path


# --------------------------------------------------------------------------- #
# 服务：把流跟踪、音量监视与归因串起来
# --------------------------------------------------------------------------- #
@dataclasses.dataclass
class LiveStream:
    key: str
    index: int
    row_id: int
    app: str
    pid: int | None
    binary: str | None
    media_name: str | None
    sink: str | None
    sample_spec: str | None
    props: dict
    ts_start: float
    last_seen: float
    corked: bool = False


class Service:
    def __init__(self, cfg: dict, store: Store):
        self.cfg = cfg
        self.store = store
        self.live: dict[str, LiveStream] = {}
        self.gone: collections.deque = collections.deque(maxlen=64)
        self.lock = threading.RLock()
        self.windows = WindowMapper(bool(cfg["use_hyprctl"]))
        self.tracker = StreamTracker(self)
        self.monitor = AudioMonitor(self)
        self._client_pids: dict[str, int] = {}
        self._client_pids_at = 0.0

    def _pid_for(self, entry: SinkInput) -> int | None:
        pid = entry.pid
        if pid:
            return pid
        if not entry.client_id:
            return None
        if now() - self._client_pids_at > 10.0:
            self._client_pids = client_pids()
            self._client_pids_at = now()
        return self._client_pids.get(entry.client_id)

    def refresh_streams(self) -> None:
        entries = list_sink_inputs()
        stamp = now()
        seen: set[str] = set()
        with self.lock:
            for entry in entries:
                key = entry.key
                seen.add(key)
                live = self.live.get(key)
                if live is None:
                    live = self._register(entry, stamp)
                    if live is None:
                        continue
                live.last_seen = stamp
                live.corked = entry.corked
                media = entry.media_name
                if media and media != live.media_name:
                    live.media_name = media
                    self.store.update_stream_media(live.row_id, media)
            for key in [k for k in self.live if k not in seen]:
                live = self.live.pop(key)
                self.store.end_stream(live.row_id, stamp)
                self.gone.append((stamp, live))

    def _register(self, entry: SinkInput, stamp: float) -> LiveStream | None:
        pid = self._pid_for(entry)
        proc = proc_metadata(pid)
        win_class, win_title = self.windows.lookup(pid)
        app = entry.app
        try:
            row_id = self.store.add_stream(
                {
                    "key": entry.key,
                    "sink_input": entry.index,
                    "ts_start": stamp,
                    "ts_end": None,
                    "app": app,
                    "binary": entry.binary,
                    "pid": pid,
                    "exe": proc["exe"],
                    "cmdline": proc["cmdline"],
                    "unit": proc["unit"],
                    "flatpak": proc["flatpak"],
                    "win_class": win_class,
                    "win_title": win_title,
                    "media_name": entry.media_name,
                    "sink": entry.sink,
                    "sample_spec": entry.sample_spec,
                    "node_name": entry.node_name,
                    "props": json.dumps(entry.props, ensure_ascii=False),
                    "clip": None,
                }
            )
        except sqlite3.Error:
            log.exception("写入音频流记录失败")
            return None
        live = LiveStream(
            key=entry.key, index=entry.index, row_id=row_id, app=app, pid=pid,
            binary=entry.binary, media_name=entry.media_name, sink=entry.sink,
            sample_spec=entry.sample_spec, props=entry.props, ts_start=stamp,
            last_seen=stamp, corked=entry.corked,
        )
        self.live[entry.key] = live
        self.monitor.watch_stream(row_id, app, stamp)
        detail = entry.media_name or win_title or proc["cmdline"] or ""
        log.info(
            "新音频流 #%s %s%s%s",
            entry.index, app,
            f" (pid {pid})" if pid else "",
            f" — {detail[:80]}" if detail else "",
        )
        if self.cfg["notify"]:
            body = detail[:120] if detail else app
            send_notification(f"♪ {app}", body)
        return live

    def attribute(self, stamp: float):
        """返回 (候选列表, 最佳候选, 置信度)。

        置信度：new=归因窗口内新建的流（提示音几乎必然是它）、single=当时只有一条
        活动的流、app-only=多条流但都来自同一个应用、unknown=无法区分。
        """
        window = float(self.cfg["attribution_window_sec"])
        with self.lock:
            live = [s for s in self.live.values() if not s.corked]
            gone = [s for (ts, s) in self.gone if stamp - ts <= window]
        pool = live + gone
        candidates = [
            {
                "app": s.app,
                "pid": s.pid,
                "sink_input": s.index,
                "media": s.media_name,
                "active_for": round(stamp - s.ts_start, 1),
            }
            for s in pool
        ]
        fresh = [s for s in pool if stamp - s.ts_start <= window]
        best: LiveStream | None = None
        confidence = "unknown"
        if fresh:
            best = max(fresh, key=lambda s: s.ts_start)
            confidence = "new"
        elif len(live) == 1:
            best = live[0]
            confidence = "single"
        elif pool and len({s.app for s in pool}) == 1:
            best = max(pool, key=lambda s: s.last_seen)
            confidence = "app-only"
        return candidates, best, confidence

    def start(self) -> None:
        self.tracker.start()
        self.monitor.start()

    def stop(self) -> None:
        self.tracker.stop()
        self.monitor.stop()

    def finalize(self) -> None:
        stamp = now()
        with self.lock:
            for live in list(self.live.values()):
                self.store.end_stream(live.row_id, stamp)
            self.live.clear()


# --------------------------------------------------------------------------- #
# 输出渲染
# --------------------------------------------------------------------------- #
def row_is_audible(row) -> bool:
    try:
        return bool(row["audible"])
    except (IndexError, KeyError):
        return False


def render_stream_row(row: sqlite3.Row, prefix: str = "▶") -> str:
    app = row["app"] or "(未知)"
    if row_is_audible(row):
        app += " ♪"
    pid = f"pid {row['pid']}" if row["pid"] else ""
    media = row["media_name"] or ""
    title = row["win_title"] or ""
    detail = media or title or (row["cmdline"] or "")
    if media and title and title != media:
        detail = f"{media}  @ {title}"
    extra = row["unit"] or row["flatpak"] or row["exe"] or ""
    line = (
        f"{Color.dim(fmt_clock(row['ts_start']))}  {Color.cyan(prefix)}  "
        f"{Color.bold(pad(app, 24))} {pad(pid, 9)} {trunc(detail, 70)}"
    )
    if extra:
        line += Color.dim(f"  [{trunc(extra, 48)}]")
    return line


def render_sound_row(row: sqlite3.Row, prefix: str = "♪") -> str:
    duration = row["duration"]
    if duration is None and row["ts_end"]:
        duration = row["ts_end"] - row["ts_start"]
    peak = row["peak_db"]
    peak_text = f"{peak:6.1f}" if peak is not None else "   ???"
    marks = {
        "new": "新建流", "single": "唯一活动流",
        "app-only": "同应用", "unknown": "无法区分",
    }
    label = f"→ {Color.magenta(row['app'] or '未知')}"
    if row["confidence"] in marks:
        label += Color.dim(f"（{marks[row['confidence']]}）")
    return (
        f"{Color.dim(fmt_clock(row['ts_start']))}  {Color.magenta(prefix)}  "
        f"{pad(fmt_dur(duration), 8)} peak {peak_text} dBFS  {label}"
    )


def print_table(
    rows: list[list[str]],
    headers: list[str],
    widths: list[int],
    first_col_colors: list | None = None,
) -> None:
    """按显示宽度对齐打印；first_col_colors 逐行给第一列上色（在补齐空格之后）。"""
    print("  ".join(Color.bold(pad(h, w)) for h, w in zip(headers, widths)))
    print(Color.dim("  ".join("-" * w for w in widths)))
    for index, row in enumerate(rows):
        cells = []
        for column, (cell, width) in enumerate(zip(row, widths)):
            padded = pad(trunc(cell, width), width)
            if column == 0 and first_col_colors and first_col_colors[index]:
                padded = first_col_colors[index](padded)
            cells.append(padded)
        print("  ".join(cells))


# --------------------------------------------------------------------------- #
# 子命令：run
# --------------------------------------------------------------------------- #
def acquire_single_instance_lock(db: str):
    """同一数据库只允许一个守护进程；返回需要保持打开的文件对象。"""
    directory = os.path.dirname(db) or "."
    os.makedirs(directory, mode=0o700, exist_ok=True)
    handle = open(  # noqa: SIM115 - 锁必须由进程生命周期持有
        os.path.join(directory, "audiosnoop.lock"), "w", encoding="utf-8"
    )
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        handle.close()
        return None
    handle.write(str(os.getpid()))
    handle.flush()
    return handle


def cmd_run(args: argparse.Namespace, cfg: dict) -> int:
    if args.clips is not None:
        cfg["capture_clips"] = args.clips
    if args.notify is not None:
        cfg["notify"] = args.notify
    if args.sink:
        cfg["sink"] = args.sink
    if args.retention_days is not None:
        cfg["retention_days"] = args.retention_days

    db = resolve_db(cfg, args.db)
    lock = acquire_single_instance_lock(db)
    if lock is None:
        log.error("已有 audiosnoop 在运行（%s），本次退出", os.path.join(os.path.dirname(db), "audiosnoop.lock"))
        return 1
    store = Store(db)
    if cfg["retention_days"] and float(cfg["retention_days"]) > 0:
        try:
            removed = store.prune(float(cfg["retention_days"]))
            if any(removed):
                log.info(
                    "清理过期数据：流 %d 条、声音 %d 条、片段 %d 个",
                    removed[0], removed[1], removed[2],
                )
        except sqlite3.Error:
            log.exception("清理过期数据失败（继续运行）")

    service = Service(cfg, store)
    stopping = threading.Event()

    def handle_signal(signum, _frame):
        if stopping.is_set():
            return
        log.info("收到信号 %s，准备退出", signum)
        stopping.set()

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        try:
            signal.signal(sig, handle_signal)
        except (ValueError, OSError):
            pass

    clips_state = f"开启 → {resolve_clips(cfg)}" if cfg["capture_clips"] else "关闭"
    log.info("%s %s 启动：数据库 %s；片段保存 %s", APP, __version__, db, clips_state)
    info = pactl_info()
    if info.get("Server Name"):
        log.info("音频服务：%s", info["Server Name"])
    else:
        log.warning("连不上音频服务（PulseAudio/PipeWire），将空转等待")
    service.start()

    next_prune = now() + 6 * 3600
    try:
        while not stopping.is_set():
            retention = cfg["retention_days"]
            if retention and float(retention) > 0 and now() >= next_prune:
                try:
                    store.prune(float(retention))
                except sqlite3.Error:
                    log.exception("定期清理失败")
                next_prune = now() + 6 * 3600
            stopping.wait(1.0)
    except KeyboardInterrupt:
        stopping.set()

    log.info("正在收尾……")
    service.stop()
    for thread in (service.tracker, service.monitor):
        thread.join(timeout=4.0)
    service.finalize()
    store.close()
    lock.close()
    log.info("已退出")
    return 0


# --------------------------------------------------------------------------- #
# 子命令：watch
# --------------------------------------------------------------------------- #
def cmd_watch(args: argparse.Namespace, cfg: dict) -> int:
    db = resolve_db(cfg, args.db)
    if not os.path.exists(db):
        print(
            f"数据库还不存在：{db}\n先启动守护进程：systemctl --user start {APP}.service",
            file=sys.stderr,
        )
        return 2
    conn = sqlite3.connect(db, timeout=5.0)
    conn.row_factory = sqlite3.Row
    try:
        if args.since:
            since = parse_time_expr(args.since)
            for row in conn.execute(
                "SELECT * FROM streams WHERE ts_start >= ? ORDER BY ts_start", (since,)
            ):
                print(render_stream_row(row))
            for row in conn.execute(
                "SELECT * FROM sounds WHERE ts_start >= ? ORDER BY ts_start", (since,)
            ):
                print(render_sound_row(row))
        last_stream = conn.execute("SELECT COALESCE(MAX(id), 0) AS m FROM streams").fetchone()["m"]
        last_sound = conn.execute("SELECT COALESCE(MAX(id), 0) AS m FROM sounds").fetchone()["m"]
        print(Color.dim(f"── 实时监视中（{db}），Ctrl-C 退出 ──"))
        while True:
            events: list[tuple[float, int, sqlite3.Row, str]] = []
            for row in conn.execute(
                "SELECT * FROM streams WHERE id > ? ORDER BY id LIMIT 200", (last_stream,)
            ):
                events.append((row["ts_start"], 0, row, "stream"))
                last_stream = max(last_stream, row["id"])
            for row in conn.execute(
                "SELECT * FROM sounds WHERE id > ? ORDER BY id LIMIT 200", (last_sound,)
            ):
                events.append((row["ts_start"], 1, row, "sound"))
                last_sound = max(last_sound, row["id"])
            events.sort(key=lambda item: (item[0], item[1]))
            for _, _, row, kind in events:
                print(render_stream_row(row) if kind == "stream" else render_sound_row(row))
            sys.stdout.flush()
            time.sleep(0.4)
    except KeyboardInterrupt:
        print()
        return 0
    finally:
        conn.close()


# --------------------------------------------------------------------------- #
# 子命令：log
# --------------------------------------------------------------------------- #
def cmd_log(args: argparse.Namespace, cfg: dict) -> int:
    db = resolve_db(cfg, args.db)
    if not os.path.exists(db):
        print(f"数据库还不存在：{db}", file=sys.stderr)
        return 2
    since = parse_time_expr(args.since) if args.since else None
    until = parse_time_expr(args.until) if args.until else None
    conn = sqlite3.connect(db, timeout=5.0)
    conn.row_factory = sqlite3.Row
    records: list[dict] = []
    try:
        if args.kind in ("all", "sound"):
            sql = (
                "SELECT sounds.*, streams.media_name AS stream_media,"
                " streams.win_title AS stream_title"
                " FROM sounds LEFT JOIN streams ON streams.id = sounds.stream_id WHERE 1=1"
            )
            params: list = []
            if since:
                sql += " AND sounds.ts_start >= ?"
                params.append(since)
            if until:
                sql += " AND sounds.ts_start <= ?"
                params.append(until)
            if args.app:
                sql += " AND sounds.app LIKE ?"
                params.append(f"%{args.app}%")
            if args.min_duration:
                sql += " AND sounds.duration >= ?"
                params.append(args.min_duration)
            if args.max_duration:
                sql += " AND sounds.duration <= ?"
                params.append(args.max_duration)
            for row in conn.execute(sql + " ORDER BY sounds.ts_start DESC", params):
                records.append({"kind": "sound", **dict(row)})
        if args.kind in ("all", "stream"):
            sql2 = "SELECT * FROM streams WHERE 1=1"
            params2: list = []
            if since:
                sql2 += " AND ts_start >= ?"
                params2.append(since)
            if until:
                sql2 += " AND ts_start <= ?"
                params2.append(until)
            if args.app:
                sql2 += " AND (app LIKE ? OR binary LIKE ?)"
                params2.extend([f"%{args.app}%", f"%{args.app}%"])
            if args.audible:
                sql2 += " AND audible = 1"
            for row in conn.execute(sql2 + " ORDER BY ts_start DESC", params2):
                records.append({"kind": "stream", **dict(row)})
    finally:
        conn.close()

    if args.grep:
        pattern = re.compile(args.grep, re.IGNORECASE)
        records = [
            rec for rec in records
            if pattern.search(
                " ".join(
                    str(rec.get(key) or "")
                    for key in ("app", "media_name", "win_title", "cmdline", "exe", "unit", "flatpak")
                )
            )
        ]

    records.sort(key=lambda rec: rec.get("ts_start") or 0, reverse=True)
    if args.limit:
        records = records[: args.limit]

    if args.json:
        for rec in records:
            rec["time"] = fmt_ts(rec.get("ts_start"))
        print(json.dumps(records, ensure_ascii=False, indent=2, default=str))
        return 0

    if args.csv:
        writer = csv.writer(sys.stdout)
        writer.writerow(
            ["kind", "time", "duration_s", "app", "pid", "media", "window", "unit", "clip"]
        )
        for rec in records:
            duration = rec.get("duration")
            if rec["kind"] == "stream" and rec.get("ts_end"):
                duration = rec["ts_end"] - rec["ts_start"]
            writer.writerow(
                [
                    rec["kind"], fmt_ts(rec.get("ts_start")),
                    f"{duration:.3f}" if duration else "",
                    rec.get("app") or "", rec.get("pid") or "",
                    rec.get("media_name") or "", rec.get("win_title") or "",
                    rec.get("unit") or "", rec.get("clip") or "",
                ]
            )
        return 0

    if not records:
        print("没有匹配的记录。", file=sys.stderr)
        return 1

    marks = {
        "new": "新建流", "single": "唯一活动流",
        "app-only": "同应用", "unknown": "无法区分",
    }
    headers = ["类型", "时间", "应用", "PID", "时长", "内容"]
    widths = [4, 19, 26, 8, 9, 60]
    table: list[list[str]] = []
    row_colors: list = []
    for rec in records:
        if rec["kind"] == "sound":
            app = rec.get("app") or "未知"
            mark = marks.get(rec.get("confidence") or "")
            detail = rec.get("stream_media") or rec.get("stream_title") or ""
            if not detail and rec.get("clip"):
                detail = os.path.basename(rec["clip"])
            if not detail and rec.get("candidates"):
                try:
                    names = [c.get("app") for c in json.loads(rec["candidates"])]
                except (TypeError, ValueError):
                    names = []
                detail = "候选：" + "、".join(dict.fromkeys(n for n in names if n))[:60] if names else ""
            table.append(
                [
                    "声音", fmt_ts(rec["ts_start"]),
                    app + (f"·{mark}" if mark else ""), "",
                    fmt_dur(rec.get("duration")), detail,
                ]
            )
            row_colors.append(Color.magenta)
        else:
            duration = (rec["ts_end"] - rec["ts_start"]) if rec.get("ts_end") else None
            detail = rec.get("media_name") or rec.get("win_title") or rec.get("cmdline") or ""
            if rec.get("media_name") and rec.get("win_title") and rec["win_title"] != rec["media_name"]:
                detail = f"{rec['media_name']} @ {rec['win_title']}"
            table.append(
                [
                    "音流", fmt_ts(rec["ts_start"]),
                    (rec.get("app") or "(未知)") + (" ·有声" if rec.get("audible") else ""),
                    str(rec.get("pid") or ""),
                    fmt_dur(duration) if duration is not None else "进行中",
                    detail,
                ]
            )
            row_colors.append(Color.cyan)
    print_table(table, headers, widths, first_col_colors=row_colors)
    print(Color.dim(f"\n共 {len(table)} 条（{fmt_ts(since)} ~ {fmt_ts(until or now())}）"))
    return 0


# --------------------------------------------------------------------------- #
# 子命令：stats
# --------------------------------------------------------------------------- #
def cmd_stats(args: argparse.Namespace, cfg: dict) -> int:
    db = resolve_db(cfg, args.db)
    if not os.path.exists(db):
        print(f"数据库还不存在：{db}", file=sys.stderr)
        return 2
    since = parse_time_expr(args.since) if args.since else None
    conn = sqlite3.connect(db, timeout=5.0)
    conn.row_factory = sqlite3.Row
    try:
        if args.kind == "sound":
            sql = (
                "SELECT COALESCE(app, '(未知)') AS app, COUNT(*) AS n,"
                " SUM(COALESCE(duration, 0)) AS total, MIN(ts_start) AS first,"
                " MAX(ts_start) AS last FROM sounds"
            )
            params: list = []
        else:
            sql = (
                "SELECT COALESCE(app, '(未知)') AS app, COUNT(*) AS n,"
                " SUM(COALESCE(ts_end, ?) - ts_start) AS total, MIN(ts_start) AS first,"
                " MAX(ts_start) AS last FROM streams"
            )
            params = [now()]
        if since:
            sql += " WHERE ts_start >= ?"
            params.append(since)
        if args.audible:
            sql += (" AND" if since else " WHERE") + " audible = 1"
        sql += " GROUP BY app ORDER BY n DESC LIMIT ?"
        params.append(args.limit)
        rows = list(conn.execute(sql, params))
    finally:
        conn.close()
    if not rows:
        print("没有统计样本。", file=sys.stderr)
        return 1
    headers = ["应用", "次数", "累计时长", "最早", "最近"]
    widths = [30, 6, 10, 19, 19]
    table = [
        [row["app"], str(row["n"]), fmt_dur(row["total"]), fmt_ts(row["first"]), fmt_ts(row["last"])]
        for row in rows
    ]
    print_table(table, headers, widths)
    return 0


# --------------------------------------------------------------------------- #
# 子命令：doctor
# --------------------------------------------------------------------------- #
def cmd_doctor(args: argparse.Namespace, cfg: dict) -> int:
    ok = True

    def line(status: bool, label: str, detail: str = "") -> None:
        nonlocal ok
        ok = ok and status
        mark = Color.green("✓") if status else Color.red("✗")
        print(f" {mark} {pad(label, 22)} {detail}")

    print(Color.bold(f"{APP} 自检"))
    line(sys.version_info >= (3, 9), "Python", sys.version.split()[0])

    binary = pactl_bin()
    line(bool(binary), "pactl", binary or "未安装（Arch: pulseaudio-utils）")
    info = pactl_info()
    server = info.get("Server Name") or ""
    line(bool(server), "音频服务", server or "连不上 /run/user/$UID/pulse/native")

    sink = default_sink()
    line(bool(sink), "默认输出设备", sink or "未知")
    mon = monitor_device(cfg["sink"])
    sources = list_monitor_names()
    line(bool(mon and mon in sources), "monitor 监视器", mon or "无法确定")

    parec = which_any("parec", "pacat")
    line(bool(parec), "parec", parec or "未安装（Arch: pulseaudio-utils）")
    hypr = which_any("hyprctl")
    line(bool(hypr), "hyprctl（窗口标题）", hypr or "未找到，只记录应用名")
    notif = which_any("notify-send")
    line(bool(notif), "notify-send（通知）", notif or "未找到，通知功能不可用（可选）")

    db = resolve_db(cfg, args.db)
    db_dir = os.path.dirname(db) or "."
    candidate = db_dir if os.path.isdir(db_dir) else os.path.dirname(db_dir) or "."
    line(os.access(candidate, os.W_OK), "数据库目录", db_dir)
    if os.path.exists(db):
        try:
            conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=5.0)
            streams = conn.execute("SELECT COUNT(*) FROM streams").fetchone()[0]
            sounds = conn.execute("SELECT COUNT(*) FROM sounds").fetchone()[0]
            newest = conn.execute(
                "SELECT MAX(ts) FROM (SELECT MAX(ts_start) AS ts FROM sounds"
                " UNION ALL SELECT MAX(ts_start) FROM streams)"
            ).fetchone()[0]
            conn.close()
            line(True, "数据库", f"{db}（流 {streams} 条 / 声音 {sounds} 条，最近 {fmt_ts(newest)}）")
        except sqlite3.Error as exc:
            line(False, "数据库", f"{db}（读取失败：{exc}）")
    else:
        line(False, "数据库", f"{db}（尚未创建，守护进程没运行过？）")

    cfg_file = cfg["_path"]
    exists = os.path.exists(cfg_file)
    line(True, "配置文件", cfg_file + ("" if exists else "（不存在，使用默认值）"))

    if which_any("systemctl"):
        _, out, _ = run_cmd(["systemctl", "--user", "is-active", f"{APP}.service"], timeout=5)
        state = (out or "").strip() or "unknown"
        _, out2, _ = run_cmd(["systemctl", "--user", "is-enabled", f"{APP}.service"], timeout=5)
        enabled = (out2 or "").strip() or "unknown"
        line(state == "active", "用户服务", f"运行 {state} / 开机自启 {enabled}")

    print()
    print(
        Color.dim(
            f"阈值：起音 {cfg['start_db']} dBFS、收音 {cfg['stop_db']} dBFS、"
            f"最短 {cfg['min_burst_sec']}s；保留 {cfg['retention_days']} 天"
        )
    )
    if not ok:
        print(Color.yellow("\n有检查项未通过；修复后可用 `audiosnoop selftest` 验证。"))
    return 0 if ok else 1


# --------------------------------------------------------------------------- #
# 子命令：prune
# --------------------------------------------------------------------------- #
def cmd_prune(args: argparse.Namespace, cfg: dict) -> int:
    db = resolve_db(cfg, args.db)
    if not os.path.exists(db):
        print(f"数据库还不存在：{db}", file=sys.stderr)
        return 2
    if args.all and not args.yes:
        if not sys.stdin.isatty():
            print("非交互环境删除全部记录需加 --yes", file=sys.stderr)
            return 2
        if input("确认删除全部历史记录？输入 yes 继续：").strip() != "yes":
            print("已取消。")
            return 1
    store = Store(db)
    try:
        if args.all:
            streams, sounds = store.clear()
            print(f"已清空：流 {streams} 条、声音 {sounds} 条")
        else:
            days = args.days if args.days is not None else cfg["retention_days"]
            if not days or float(days) <= 0:
                print("保留期 <= 0，未删除任何数据（用 --days N 或 --all 明确指定）")
                return 0
            n_streams, n_sounds, n_clips = store.prune(float(days))
            print(f"删除流 {n_streams} 条、声音 {n_sounds} 条、片段 {n_clips} 个（保留 {days} 天）")
        if args.vacuum:
            store.vacuum()
            print("已 VACUUM 回收空间。")
    finally:
        store.close()
    return 0


# --------------------------------------------------------------------------- #
# 子命令：selftest
# --------------------------------------------------------------------------- #
def synth_tone(path: str, freq: float = 880.0, seconds: float = 0.7, rate: int = 48000) -> None:
    samples = array.array("h")
    total = int(rate * seconds)
    for i in range(total):
        envelope = min(1.0, i / (0.02 * rate), max(0.0, (total - i) / (0.06 * rate)))
        samples.append(int(0.22 * 32767 * envelope * math.sin(2 * math.pi * freq * i / rate)))
    with wave.open(path, "wb") as handle:
        handle.setnchannels(1)
        handle.setsampwidth(2)
        handle.setframerate(rate)
        handle.writeframes(samples.tobytes())


def cmd_selftest(args: argparse.Namespace, cfg: dict) -> int:
    db = resolve_db(cfg, args.db)
    if not os.path.exists(db):
        print(
            f"数据库还不存在：{db}\n先启动守护进程：systemctl --user start {APP}.service",
            file=sys.stderr,
        )
        return 2
    player = which_any("paplay", "pw-play")
    if not player:
        print("找不到 paplay/pw-play，无法播放测试音", file=sys.stderr)
        return 2

    started = now()
    with tempfile.TemporaryDirectory() as tmp:
        bell = "/usr/share/sounds/freedesktop/stereo/bell.oga"
        if not os.path.exists(bell):
            bell = os.path.join(tmp, "audiosnoop-selftest.wav")
            synth_tone(bell)
        code, _, err = run_cmd([player, bell], timeout=15)
        if code != 0:
            print(f"播放测试音失败：{err.strip()}", file=sys.stderr)
            return 2
        print(f"已播放测试音 {os.path.basename(bell)}，等待 3 秒观察记录……")

    time.sleep(3.0)
    conn = sqlite3.connect(db, timeout=5.0)
    conn.row_factory = sqlite3.Row
    try:
        sounds = list(
            conn.execute(
                "SELECT * FROM sounds WHERE ts_start >= ? ORDER BY ts_start DESC LIMIT 5",
                (started - 1.0,),
            )
        )
        streams = list(
            conn.execute(
                "SELECT * FROM streams WHERE ts_start >= ? ORDER BY ts_start DESC LIMIT 5",
                (started - 1.0,),
            )
        )
    finally:
        conn.close()

    if not sounds and not streams:
        print(Color.red("✗ 没有捕获到任何记录：守护进程可能没运行，或 monitor 设备不对。"))
        print("  排查：systemctl --user status audiosnoop.service")
        print("        journalctl --user -u audiosnoop -n 50")
        return 1
    for row in streams:
        print(render_stream_row(row))
    for row in sounds:
        print(render_sound_row(row))
    if sounds:
        print(Color.green("\n✓ 自检通过：声音已被捕获并归因。"))
        return 0
    print(
        Color.yellow(
            "\n△ 捕获到音频流，但没检测到出声：可能阈值偏高或播放音量过低。"
            "可把 config.json 的 start_db 调低（如 -55）。"
        )
    )
    return 1


# --------------------------------------------------------------------------- #
# 参数解析
# --------------------------------------------------------------------------- #
def parse_time_expr(text: str) -> float:
    text = text.strip()
    match = re.fullmatch(r"(\d+(?:\.\d+)?)\s*([smhdw])", text)
    if match:
        return now() - float(match.group(1)) * TIME_UNITS[match.group(2)]
    for fmt in (
        "%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%d",
        "%Y-%m-%dT%H:%M:%S", "%Y-%m-%dT%H:%M",
    ):
        try:
            return time.mktime(time.strptime(text, fmt))
        except ValueError:
            continue
    match = re.fullmatch(r"(\d{1,2}):(\d{2})(?::(\d{2}))?", text)
    if match:
        current = datetime.datetime.now()
        target = current.replace(
            hour=int(match.group(1)), minute=int(match.group(2)),
            second=int(match.group(3) or 0), microsecond=0,
        )
        if target > current:
            target -= datetime.timedelta(days=1)
        return target.timestamp()
    raise argparse.ArgumentTypeError(
        f"无法解析时间 {text!r}；可用 30m / 2h / 7d / '2026-11-20 10:00' / '10:30'"
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=APP,
        description="记录本机哪个软件在什么时候播放了声音（PulseAudio / PipeWire）。",
        epilog=(
            "常用：\n"
            f"  {APP} watch                  # 实时看谁在建流、谁在出声\n"
            f"  {APP} log --since 15m        # 回查最近 15 分钟\n"
            f"  {APP} log --app Firefox --json\n"
            f"  {APP} stats --since 7d\n"
            f"  {APP} doctor                 # 自检\n"
            f"  {APP} selftest               # 播测试音验证\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--version", action="version", version=f"{APP} {__version__}")
    parser.add_argument("--db", help="覆盖数据库路径（也可用 AUDIOSNOOP_DB）")
    parser.add_argument("--config", help="覆盖配置文件路径")
    parser.add_argument("-v", "--verbose", action="store_true", help="输出调试日志")
    sub = parser.add_subparsers(dest="command")

    run = sub.add_parser("run", help="前台运行守护进程（systemd unit 调用的就是它）")
    run.add_argument("--clips", dest="clips", action="store_true", default=None,
                     help="保存每次出声的 WAV 片段")
    run.add_argument("--no-clips", dest="clips", action="store_false", default=None,
                     help="不保存片段")
    run.add_argument("--notify", dest="notify", action="store_true", default=None,
                     help="新音频流出现时发桌面通知")
    run.add_argument("--no-notify", dest="notify", action="store_false", default=None,
                     help="不发通知")
    run.add_argument("--sink", help="监听指定 sink（默认跟随系统默认输出）")
    run.add_argument("--retention-days", type=float, help="覆盖数据保留天数")

    watch = sub.add_parser("watch", help="实时滚动显示新的音频流与出声事件")
    watch.add_argument("--since", help="先回放最近一段（如 10m）")

    log_cmd = sub.add_parser("log", help="查询历史")
    log_cmd.add_argument("--since", help="起始时间（30m / 2h / 7d / '2026-11-20 10:00'）")
    log_cmd.add_argument("--until", help="结束时间")
    log_cmd.add_argument("--app", help="按应用名过滤（模糊匹配）")
    log_cmd.add_argument("--grep", help="在应用/媒体名/窗口标题/命令行里做正则搜索")
    log_cmd.add_argument("--kind", choices=["all", "sound", "stream"], default="all",
                         help="只看出声（sound）或只看音频流（stream）")
    log_cmd.add_argument("--audible", action="store_true",
                         help="只看确实发出了声音的音频流（配合 --kind stream）")
    log_cmd.add_argument("--min-duration", type=float, help="最短时长（秒，仅 sound）")
    log_cmd.add_argument("--max-duration", type=float, help="最长时长（秒，仅 sound）")
    log_cmd.add_argument("--limit", type=int, default=50, help="最多显示条数（默认 50）")
    log_cmd.add_argument("--json", action="store_true", help="输出 JSON")
    log_cmd.add_argument("--csv", action="store_true", help="输出 CSV")

    stats = sub.add_parser("stats", help="按应用聚合统计")
    stats.add_argument("--since", help="统计窗口（默认全部）")
    stats.add_argument("--kind", choices=["sound", "stream"], default="sound",
                       help="统计出声次数（默认）还是音频流")
    stats.add_argument("--audible", action="store_true",
                       help="只统计确实发出了声音的音频流（配合 --kind stream）")
    stats.add_argument("--limit", type=int, default=20)

    sub.add_parser("doctor", help="自检")

    prune = sub.add_parser("prune", help="清理过期数据")
    prune.add_argument("--days", type=float, help="保留天数（默认取配置）")
    prune.add_argument("--all", action="store_true", help="删除全部记录")
    prune.add_argument("--yes", action="store_true", help="--all 时跳过确认")
    prune.add_argument("--vacuum", action="store_true", help="删除后 VACUUM")

    sub.add_parser("selftest", help="播放测试音，验证捕获与归因")
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    logging.basicConfig(
        level=logging.DEBUG if args.verbose else logging.INFO,
        format="%(asctime)s %(levelname)-7s %(message)s",
        datefmt="%H:%M:%S",
        stream=sys.stderr,
    )
    cfg = load_config(args.config)
    if os.environ.get("AUDIOSNOOP_DB") and not args.db:
        args.db = os.environ["AUDIOSNOOP_DB"]
    handlers = {
        "run": cmd_run, "watch": cmd_watch, "log": cmd_log, "stats": cmd_stats,
        "doctor": cmd_doctor, "prune": cmd_prune, "selftest": cmd_selftest,
    }
    command = args.command or "run"
    try:
        return handlers[command](args, cfg)
    except KeyboardInterrupt:
        return 130
    except argparse.ArgumentTypeError as exc:
        print(f"参数错误：{exc}", file=sys.stderr)
        return 2
    except sqlite3.Error as exc:
        log.error("数据库错误：%s", exc)
        return 3
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
