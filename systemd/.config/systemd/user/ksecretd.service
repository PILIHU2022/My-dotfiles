[Unit]
Description=KDE Secret Service daemon (ksecretd, KWallet-backed)
Documentation=https://invent.kde.org/frameworks/kwallet
# 这是 KWallet 6 的 org.freedesktop.secrets 实现。ksecretd 内嵌了完整的
# org.freedesktop.Secret.{Service,Collection,Item,Session,Prompt} 接口，并在启动时
# 申请 org.freedesktop.secrets 这个名字。
# （该名字在二进制里以 Qt QStringLiteral 也就是 UTF-16 形式内嵌，ASCII 搜不到；
#   用 UTF-16LE 搜可命中独立字符串 org.freedesktop.secrets。）
#
# 发行版没有给 ksecretd 提供 systemd unit，只有两个 D-Bus 激活文件
# （org.kde.secretservicecompat / org.freedesktop.impl.portal.desktop.kwallet），
# 所以由本仓库自己托管，保证它随会话启动、并在应用之前占住总线名。
PartOf=graphical-session.target
After=graphical-session.target
# ksecretd 通过 D-Bus 借用 kwalletd6 存取钱包。
Wants=kwalletd6.service
After=kwalletd6.service
# 关键顺序：必须早于需要密钥的应用。否则 org.freedesktop.secrets 无人持有，
# 会被 gnome-keyring 的 D-Bus 激活文件
# （/usr/share/dbus-1/services/org.freedesktop.secrets.service）
# 抢先激活 —— 那样密钥就又回到 gnome-keyring 去了。
Before=hyprland-autostart.target

[Service]
Type=exec
ExecStart=/usr/bin/ksecretd
# ksecretd 链接了 libQt6Gui（和 kwalletd6 一样），拿不到 Wayland socket 时
# Qt 会直接 abort，所以给一份候选平台列表 + xcb 回退。
# 这里是字面量、不经 shell，';' 不会被当作命令分隔符。
Environment=QT_QPA_PLATFORM=wayland;xcb
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
